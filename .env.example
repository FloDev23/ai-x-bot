# Required X credentials (one approved draft is the only X write path)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# Required generation and Telegram approval credentials
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# The official https://flexdropin.com/api/editorial-feed is fixed in code and
# needs no secret or environment variable. These two values control only the
# optional external-news channel; NEWSAPI_KEY becomes mandatory when the
# allowlist is non-empty.
NEWSAPI_KEY=
NEWS_TRUSTED_DOMAINS=

# Approval-only rollout defaults
BOT_TIMEZONE=Europe/Rome
POSTS_PER_DAY=2
THIRD_POST_DAYS_PER_WEEK=3
APPROVED_QUEUE_TARGET=14
PENDING_REVIEW_LIMIT=5
DRAFT_GENERATION_DAILY_CAP=5
AUDIENCE_TIMEZONE=America/New_York
MORNING_WINDOW=08:30-10:30
MIDDAY_WINDOW=13:00-15:30
EVENING_WINDOW=18:00-20:30
MIN_POST_GAP_HOURS=4
ADAPTIVE_TIMING_MIN_POSTS=30
ADAPTIVE_WEEKDAY_MIN_POSTS=90
THIRD_POST_TIMING_MIN_POSTS=30
PUBLICATION_PLAN_GRACE_MINUTES=90
APPROVAL_REQUIRED=true
DRY_RUN=true
DRAFT_SCORE_THRESHOLD=70
SEMANTIC_DUPLICATE_THRESHOLD=0.72
MAX_LINKS_PER_WEEK=1
ENABLE_LEAD_DISCOVERY=false
MEDIA_MATCH_THRESHOLD=80
MEDIA_LIBRARY_DIR=media_library
TELEGRAM_POLL_TIMEOUT=25
TELEGRAM_MAX_IMAGE_BYTES=10485760
TELEGRAM_MAX_VIDEO_BYTES=52428800

# Read-only follower growth discovery
GROWTH_SCORE_THRESHOLD=75
GROWTH_QUERY_BUDGET=3
GROWTH_NEW_PROFILE_BUDGET=25
GROWTH_PROFILE_CACHE_DAYS=7
GROWTH_DIGEST_LIMIT=5
GROWTH_SEED_ACCOUNTS=
GROWTH_DIGEST_TIME=09:00
GROWTH_ACCOUNT_SUGGESTION_LIMIT=5
GROWTH_POST_SUGGESTION_LIMIT=10
GROWTH_POST_QUERY_BUDGET=2
GROWTH_SUGGESTION_COOLDOWN_DAYS=30
GROWTH_UNFOLLOW_REVIEW_DAYS=14

# Optional secondary, read-only lead suggestions
OPPORTUNITY_CYCLE_TIMES=10:00,16:00
